# Copia este archivo como .env (no se sube a git) y completa los valores.

# Contraseña de la base de datos (del Postgres local o del contenedor "db")
DB_PASSWORD=cambia-esto

# Firma de los tokens de la API: mínimo 32 caracteres aleatorios
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas

# Correo que envía y recibe las notificaciones
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DESTINO=

# Solo el frontend, si la API no está en http://localhost:8081
# API_URL=http://localhost:8081
