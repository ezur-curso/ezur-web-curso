# Copia este archivo como .env (no se sube a git) y completa los valores.

# PostgreSQL
POSTGRES_DB=CAMBIAR_POR_EL_NOMBRE_DE_LA_BASE_DE_DATOS_LOCAL
POSTGRES_USER=CAMBIAR_POR_EL_NOMBRE_DEL_USUARIO_LOCAL
POSTGRES_PASSWORD=CAMBIAR_POR_LA_CONTRASEÑA_DEL_USUARIO_LOCAL

# JWT (generar una clave Base64 segura de 32 bytes)
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_BASE64_SEGURA_DE_32_BYTES

# Administrador inicial
EZUR_ADMIN_USERNAME=CAMBIAR_POR_UNA_CUENTA_DE_CORREO
EZUR_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL

# Mail
MAIL_USERNAME=CAMBIAR_POR_UNA_CUENTA_DE_CORREO
MAIL_PASSWORD=CAMBIAR_POR_LA_CONTRASEÑA_DEL_CORREO
MAIL_TO=CAMBIAR_POR_UNA_CUENTA_DE_CORREO_DESTINO

API_BASE_URL=CAMBIAR_POR_LA_URL_DEL_BACKEND